+#if defined(TW_INCLUDE_CRYPTO) && defined(TW_INCLUDE_FBE_METADATA_DECRYPT) && defined(USE_FSCRYPT)
+static bool Mount_Metadata_Encrypted_With_Retry(const std::string& blk_device, const std::string& mount_point, const std::string& fs_type, const std::string& fstab) {
+	const int max_attempts = 20;
+	for (int attempt = 1; attempt <= max_attempts; attempt++) {
+		if (android::vold::fscrypt_mount_metadata_encrypted(blk_device, mount_point, false, false, fs_type, fstab))
+			return true;
+		LOGINFO("Metadata decrypt attempt %d/%d failed, retrying in 1s\n", attempt, max_attempts);
+		sleep(1);
+	}
+	return false;
+}
+#endif
